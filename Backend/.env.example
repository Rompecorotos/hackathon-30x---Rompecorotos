# Copia este archivo a .env.local y completa los valores (nunca subas .env.local a Git).
# Supabase > Project Settings > API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publicable (sb_publishable_...) o la clave "anon" legacy. NO uses service_role/secret.
SUPABASE_PUBLISHABLE_KEY=

# Asistente IA (Google Gemini, plan gratuito). Crea la clave en https://aistudio.google.com/apikey
# Solo se usa en el servidor; nunca la expongas en el frontend.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Límites por usuario para no agotar la cuota gratuita.
AI_DAILY_LIMIT=50
AI_PER_MINUTE_LIMIT=6

# Origen(es) del frontend autorizados a llamar a la API, separados por comas.
# El primero se usa para el enlace de confirmación de email y las redirecciones.
FRONTEND_ORIGIN=http://localhost:5173
